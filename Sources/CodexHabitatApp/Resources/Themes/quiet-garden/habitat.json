{
  "schemaVersion": 1,
  "id": "quiet-garden",
  "name": "Quiet Garden",
  "version": "1.0.0",
  "author": "Codex Habitat Contributors",
  "license": {"spdx": "MIT", "file": "LICENSE"},
  "minimumRuntimeVersion": "1.0.0",
  "modes": ["light", "dark"],
  "preview": "preview.png",
  "colors": {
    "surface": "#F5F8F4",
    "text": "#203127",
    "accent": "#3D8B63",
    "attention": "#C86A45",
    "error": "#C4455D"
  },
  "assets": [],
  "pets": [],
  "widgets": [
    {
      "id": "codex.status",
      "anchor": "topLeading",
      "position": {"x": 0.06, "y": 0.08},
      "configuration": {"type": "status", "showsConnectionHealth": true}
    },
    {
      "id": "codex.usage",
      "anchor": "topTrailing",
      "position": {"x": 0.94, "y": 0.08},
      "configuration": {"type": "usage", "bucket": "primary"}
    },
    {
      "id": "system.clock",
      "anchor": "bottomLeading",
      "position": {"x": 0.06, "y": 0.92},
      "configuration": {"type": "clock", "uses24HourClock": false}
    },
    {
      "id": "timer.pomodoro",
      "anchor": "bottomTrailing",
      "position": {"x": 0.94, "y": 0.92},
      "configuration": {"type": "pomodoro", "focusSeconds": 1500, "restSeconds": 300}
    }
  ]
}
