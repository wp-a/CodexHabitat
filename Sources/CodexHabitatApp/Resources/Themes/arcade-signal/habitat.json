{
  "schemaVersion": 1,
  "id": "arcade-signal",
  "name": "Arcade Signal",
  "version": "1.0.0",
  "author": "Codex Habitat Contributors",
  "license": {"spdx": "MIT", "file": "LICENSE"},
  "minimumRuntimeVersion": "1.0.0",
  "modes": ["light", "dark"],
  "preview": "preview.png",
  "colors": {
    "surface": "#14151A",
    "text": "#F7F7F2",
    "accent": "#2D8CFF",
    "attention": "#FFD23F",
    "error": "#FF4D5A"
  },
  "assets": [],
  "pets": [],
  "widgets": [
    {
      "id": "codex.status",
      "anchor": "topLeading",
      "position": {"x": 0.05, "y": 0.08},
      "configuration": {"type": "status", "showsConnectionHealth": true}
    },
    {
      "id": "codex.usage",
      "anchor": "topTrailing",
      "position": {"x": 0.95, "y": 0.08},
      "configuration": {"type": "usage", "bucket": "primary"}
    },
    {
      "id": "system.clock",
      "anchor": "bottomLeading",
      "position": {"x": 0.05, "y": 0.92},
      "configuration": {"type": "clock", "uses24HourClock": true}
    },
    {
      "id": "timer.pomodoro",
      "anchor": "bottomTrailing",
      "position": {"x": 0.95, "y": 0.92},
      "configuration": {"type": "pomodoro", "focusSeconds": 1500, "restSeconds": 300}
    }
  ]
}
