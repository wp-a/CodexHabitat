{
  "schemaVersion": 1,
  "id": "workbench",
  "name": "Workbench",
  "version": "1.0.0",
  "author": "Codex Habitat Contributors",
  "license": {"spdx": "MIT", "file": "LICENSE"},
  "minimumRuntimeVersion": "1.0.0",
  "modes": ["light", "dark"],
  "preview": "preview.png",
  "colors": {
    "surface": "#F4F7F8",
    "text": "#172126",
    "accent": "#0F8B8D",
    "attention": "#D97706",
    "error": "#D64545"
  },
  "assets": [],
  "pets": [],
  "widgets": [
    {
      "id": "codex.status",
      "anchor": "topLeading",
      "position": {"x": 0.04, "y": 0.06},
      "configuration": {"type": "status", "showsConnectionHealth": true}
    },
    {
      "id": "codex.usage",
      "anchor": "topTrailing",
      "position": {"x": 0.96, "y": 0.06},
      "configuration": {"type": "usage", "bucket": "primary"}
    },
    {
      "id": "system.clock",
      "anchor": "bottomLeading",
      "position": {"x": 0.04, "y": 0.94},
      "configuration": {"type": "clock", "uses24HourClock": false}
    },
    {
      "id": "timer.pomodoro",
      "anchor": "bottomTrailing",
      "position": {"x": 0.96, "y": 0.94},
      "configuration": {"type": "pomodoro", "focusSeconds": 1500, "restSeconds": 300}
    }
  ]
}
