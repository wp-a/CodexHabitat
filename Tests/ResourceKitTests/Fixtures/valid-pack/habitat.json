{
  "schemaVersion": 1,
  "id": "studio.example.workbench",
  "name": "Example Workbench",
  "version": "1.2.0",
  "author": "Example Studio",
  "license": {
    "spdx": "MIT",
    "file": "LICENSE"
  },
  "minimumRuntimeVersion": "1.0.0",
  "modes": ["light", "dark"],
  "preview": "preview.png",
  "colors": {
    "surface": "#F4F6F8",
    "text": "#1C1C1E",
    "accent": "#14B8A6",
    "attention": "#F59E0B",
    "error": "#EF4444"
  },
  "assets": [
    {
      "type": "image",
      "id": "desk-texture",
      "path": "artwork/desk.png",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "rendering": "smooth"
    },
    {
      "type": "font",
      "id": "metric-font",
      "path": "fonts/MetricMono.otf",
      "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    }
  ],
  "pets": [
    {
      "id": "desk-buddy",
      "path": "pets/desk-buddy",
      "rendering": "pixelated",
      "scale": 1.25
    }
  ],
  "widgets": [
    {
      "id": "codex.status",
      "anchor": "topLeading",
      "position": {"x": 0.04, "y": 0.06},
      "configuration": {
        "type": "status",
        "showsConnectionHealth": true
      }
    },
    {
      "id": "codex.usage",
      "anchor": "topTrailing",
      "position": {"x": 0.96, "y": 0.06},
      "configuration": {
        "type": "usage",
        "bucket": "primary"
      }
    },
    {
      "id": "system.clock",
      "anchor": "bottomLeading",
      "position": {"x": 0.04, "y": 0.94},
      "configuration": {
        "type": "clock",
        "uses24HourClock": false
      }
    },
    {
      "id": "timer.pomodoro",
      "anchor": "bottomTrailing",
      "position": {"x": 0.96, "y": 0.94},
      "configuration": {
        "type": "pomodoro",
        "focusSeconds": 1500,
        "restSeconds": 300
      }
    }
  ]
}
